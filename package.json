{
    "name":  "@business/platform",
    "version":  "0.1.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "concurrently -n web,api -c cyan,green \"npm run dev -w @business/web\" \"npm run dev -w @business/api\"",
                    "dev:web":  "npm run dev -w @business/web",
                    "dev:api":  "npm run dev -w @business/api",
                    "build":  "npm run build -ws --if-present",
                    "lint":  "npm run lint -ws --if-present",
                    "typecheck":  "npm run typecheck -ws --if-present",
                    "check":  "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run test \u0026\u0026 npm run build",
                    "db:generate":  "npm run db:generate -w @business/database",
                    "db:migrate":  "npm run db:migrate -w @business/database",
                    "db:studio":  "npm run db:studio -w @business/database",
                    "db:create":  "npm run db:create -w @business/database",
                    "db:setup":  "npm run db:create \u0026\u0026 npm run db:generate \u0026\u0026 npm run db:migrate",
                    "test":  "npm run test -ws --if-present"
                },
    "devDependencies":  {
                            "concurrently":  "^9.2.1",
                            "typescript":  "^5.9.3"
                        }
}
